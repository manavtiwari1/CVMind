# Port for the Express backend server
PORT=5000

# Google Gemini API Key (obtain for free from https://aistudio.google.com/)
# Configure this key to enable global free resume checks for all users.
# If omitted, the application will require users to input their own keys in the frontend interface.
GEMINI_API_KEY=your_gemini_api_key_here

# Auto-apply agent models (override when Google retires a model). Embeddings are truncated to GEMINI_EMBED_DIMS.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# Auto-apply agent jobs only run when a queue worker is running. In production run "npm run worker"
# from the repo root (or auto-apply-agent/Dockerfile) as a separate process. For local dev, uncomment to run workers inside the API.
# INLINE_WORKERS=true

# CVMind Code runs Python and C++ as ordinary processes on this server, not in a sandbox, so they are
# off unless this is "true". Turn it on only for local development or inside an isolated container.
# CODE_NATIVE_RUNNERS=true

# Optional: configure to enable live job listings with true direct apply URLs.
# Without this, AI Job Finder can suggest matches but cannot guarantee one-click direct apply pages.
RAPIDAPI_KEY=your_rapidapi_key_for_jsearch_here

# MongoDB URI (configure to enable permanent cloud database for production/Vercel/Render)
# If omitted, the application will automatically fall back to local JSON document db.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/resumetrics?retryWrites=true&w=majority

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
# Authorization callback URL: <backend-url>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# LinkedIn OAuth (create an app at https://www.linkedin.com/developers/apps, enable "Sign In with LinkedIn using OpenID Connect")
# Authorized redirect URL: <backend-url>/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Public URL of this backend (used to build OAuth callback URLs behind proxies, e.g. Render)
BACKEND_PUBLIC_URL=https://your-backend-host.example.com

# Public URL of the frontend (defaults to https://www.cvmind.in)
FRONTEND_URL=https://www.cvmind.in


# Secret used to sign session tokens for users and companies (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string

# Admin panel owner. Signs in at /admin; becomes the first "owner" team member once MongoDB is connected.
# Other team members and their roles are managed in the admin panel (Settings → Team).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace_with_a_long_password

# Email (Resend): welcome emails, password resets, support replies and admin notifications
RESEND_API_KEY=
# Who emails come from. The domain must be verified in Resend.
EMAIL_FROM="CVMind <support@cvmind.in>"
# Inbox that receives customers' replies to support and notification emails
SUPPORT_EMAIL=cvmindofficial@gmail.com
# Pull that inbox into Admin → Support (read-only). Needs a Google App Password:
# turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
SUPPORT_INBOX_APP_PASSWORD=
# Optional: a different mailbox or a non-Gmail IMAP server
# SUPPORT_INBOX_USER=cvmindofficial@gmail.com
# SUPPORT_INBOX_HOST=imap.gmail.com

# Payments (Cashfree Payment Gateway): https://merchant.cashfree.com → Developers → API Keys
# Leave empty to turn online payment off (the pricing page then asks buyers to contact support).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "production" for live payments; anything else uses the sandbox. Sandbox and live keys differ.
CASHFREE_ENV=sandbox
# Payment webhook. Defaults to ${BACKEND_PUBLIC_URL}/api/billing/webhook when that is https.
# Add the same URL in Cashfree → Developers → Webhooks.
# CASHFREE_NOTIFY_URL=https://your-backend-host.example.com/api/billing/webhook

# AI Job Finder: JSearch (Google for Jobs listings) through RapidAPI → https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Leave empty and Job Finder shows only company job boards and CVMind Company Portal jobs.
JSEARCH_API_KEY=
# Calls allowed per calendar month. Paid plans bill every request past their quota, so keep this
# below the plan's quota (Pro: 10,000). Searches are cached for an hour and only count once.
JSEARCH_MONTHLY_CAP=9000
# Country the searches are for (two-letter code)
# JSEARCH_COUNTRY=in

# AI Job Finder: Adzuna job search API (all fields, India included) → https://developer.adzuna.com
# Free plan: about 250 calls a day and 2,500 a month. Leave empty to skip Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Keep these below the plan's limits; searches are cached for an hour and only count once
ADZUNA_MONTHLY_CAP=2400
ADZUNA_DAILY_CAP=240
# ADZUNA_COUNTRY=in
