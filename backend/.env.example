# Port for the Express backend server
PORT=5000

# Google Gemini API Key (obtain for free from https://aistudio.google.com/)
# Configure this key to enable global free resume checks for all users.
# If omitted, the application will require users to input their own keys in the frontend interface.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: configure to enable live job listings with true direct apply URLs.
# Without this, AI Job Finder can suggest matches but cannot guarantee one-click direct apply pages.
RAPIDAPI_KEY=your_rapidapi_key_for_jsearch_here

# MongoDB URI (configure to enable permanent cloud database for production/Vercel/Render)
# If omitted, the application will automatically fall back to local JSON document db.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/resumetrics?retryWrites=true&w=majority

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
# Authorization callback URL: <backend-url>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# LinkedIn OAuth (create an app at https://www.linkedin.com/developers/apps, enable "Sign In with LinkedIn using OpenID Connect")
# Authorized redirect URL: <backend-url>/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Public URL of this backend (used to build OAuth callback URLs behind proxies, e.g. Render)
BACKEND_PUBLIC_URL=https://your-backend-host.example.com
