{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "entrypoint": "src/index.js"
    }
  },
  "crons": [
    {
      "path": "/_/backend/api/cron/job-alerts",
      "schedule": "17 3 * * *"
    }
  ]
}
